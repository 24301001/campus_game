      {"type": "page_number", "bbox": [0.843,0.081,0.875,0.095], "content": [{"type":"text","content":"27"}]},
      {"type": "text", "bbox": [0.115,0.118,0.821,0.138], "content": [
        {"type":"text","content":"证 设 "},
        {"type":"equation_inline","content":"f(x) = x + 1"},
        {"type":"text","content":" ，则对任何 "},
        {"type":"equation_inline","content":"\\varepsilon > 0"}
      ]},
      {"type": "equation", "bbox": [0.339,0.144,0.641,0.164],
       "content": "\\left| f(x) - 2 \\right| = \\left| x - 1 \\right| < \\varepsilon,"},
      {"type": "text", "content": [{"type":"text","content":"因此 "},
        {"type":"equation_inline","content":"\\lim_{x \\to 1} (x + 1) = 2."}]},
      {"type": "image", "bbox": [0.068,0.108,0.364,0.314], "content": []},
      {"type": "footer", "content": [{"type":"text","content":"极限"}]},
      {"type": "page_footnote", "content": [{"type":"text","content":"*本节大纲要求"}]}
    ]},
    {"page_idx": 40, "blocks": [
      {"type": "header", "content": [{"type":"text","content":"2.2 函数的极限"}]},
      {"type": "page_number", "content": [{"type":"text","content":"28"}]},
      {"type": "paragraph_title", "content": [{"type":"text","content":"3. 无穷极限"}]},
      {"type": "text", "content": [{"type":"text","content":"例2.8 证明 "},
        {"type":"equation_inline","content":"\\lim_{x \\to 1} \\frac{x^2 - 1}{x - 1} = 2."}]}
    ]}
