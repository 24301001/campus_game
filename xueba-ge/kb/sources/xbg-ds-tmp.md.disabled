int* returnSize, int** returnColumnSizes)
重塑矩阵
{//
int m = matSize;
int n = matColSize[0];
给定参数的 操作不合理，返回原矩阵
if (m * n != r * c) // reshape
{
*returnSize = matSize;
*returnColumnSizes = matColSize;
return mat;
}
*returnSize = r;
*returnColumnSizes =(int*)malloc(r*sizeof(int));
int** ans = (int**)malloc(r*sizeof(int*));
对重塑的新矩阵进行初始化
for (int i = 0; i < r; i++) //
{

