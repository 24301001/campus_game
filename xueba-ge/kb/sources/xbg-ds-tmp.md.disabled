struct ListNode* rotateRight(struct ListNode* head, int k)
将链表的每个结点向右移动 个位置 { // k
if (k == 0 || head == NULL || head->next == NULL)
如果链表长度不大于 ，或 ，返回原链表 return head; // 1 k=0
int n = 1;
