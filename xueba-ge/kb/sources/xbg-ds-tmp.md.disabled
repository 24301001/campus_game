flag=0; //flag 0
for(j=1;j<=m;j++)
if(L.r[j].key>L.r[j+1].key)
{
置为 ，表示本趟排序发生了交换
flag=1; //flag 1
交换前后两个记录
t=L.r[j]; L.r[j]=L.r[j+1]; L.r[j+1]=t;//
} //if

