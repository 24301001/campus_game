{// key T
将二叉排序树 初始化为空树
T=NULL; // T
cin>>e;
为自定义常量，作为输入结束标志
while(e.key!=ENDFLAG) //ENDFLAG
{
将此结点插入二叉排序树 中
InsertBST(T,e); // T
cin>>e;
}
}

