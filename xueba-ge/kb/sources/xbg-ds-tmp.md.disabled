【算法描述】
int networkDelayTime(int** times, int timesSize, int* timesColSize, int n,
int k)
计算从结点 发出一个信号，使所有结点都收到信号的时间
{// k
const int inf = 0x3f3f3f3f;
int** g = (int**)malloc(n * sizeof(int*));
for (int i = 0; i < n; i++) {
g[i] = (int*)malloc(n * sizeof(int));
memset(g[i], inf, sizeof(int) * n);
}
将结点间的信号传递时间记录在 中
for (int i = 0; i < timesSize; i++) // g
{
int v1 = times[i][0], v2 = times[i][1];
g[v1 - 1][v2 - 1] = times[i][2];
}
记录从 到其余各点的最短路
int* dist = (int*)malloc(n * sizeof(int)); // k
memset(dist, inf, sizeof(int) * n);
dist[k - 1] = 0;
记录结点是否为已确定结点
int* used = (int*)malloc(n * sizeof(int)); //
memset(used, 0, sizeof(int) * n);
int ans = 0;
for (int i = 0; i < n; ++i)
{
int x = -1;
查找未确定结点中到源结点路径长度最短的结点
for (int y = 0; y < n; ++y) //
if (!used[y] && (x == -1 || dist[y] < dist[x]))
x = y;
将查找到的结点标记为已确定
used[x] = true; //
更新最短路径长度的最大值
ans = fmax(ans, dist[x]); //
更新其他结点到源结点的最短路径长度
for (int y = 0; y < n; ++y) //
dist[y] = fmin(dist[y], dist[x] + g[x][y]);
}
返回所需时间
return ans == inf ? -1 : ans; //
}
【算法分析】
数组times的长度为m时，时间复杂度为O(n2 + m)；邻接矩阵需占用O(n2)的空间，因此空
间复杂度为O(n2)。
