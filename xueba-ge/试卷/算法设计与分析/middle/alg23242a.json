            0.724
          ],
          "content": [
            {
              "type": "text",
              "content": "（1）请帮助她设计一个动态规划算法，根据输入 "
            },
            {
              "type": "equation_inline",
              "content": "L 、 n 、 L_{1} 、 L_{2} 、 \\cdots 、 L_{N},"
            },
            {
              "type": "text",
              "content": "计算此时的最小总开销。(你可以定义并使用变量 "
            },
            {
              "type": "equation_inline",
              "content": "p_{0}=0;p_{i}=\\sum_{j=1}^{i}L_{j},1\\leq i\\leq N_{\\circ}"
            }
          ]
