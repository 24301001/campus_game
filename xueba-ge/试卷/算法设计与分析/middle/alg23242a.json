              "content": "<table><tr><td>金板编号</td><td>重量</td><td>价值</td></tr><tr><td>1</td><td>2</td><td>10</td></tr><tr><td>2</td><td>4</td><td>10</td></tr><tr><td>3</td><td>6</td><td>12</td></tr><tr><td>4</td><td>9</td><td>18</td></tr></table>"
