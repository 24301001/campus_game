          ],
          "content": [
            {
              "type": "text",
              "content": "(1）下列陈述中（）表明 "
            },
            {
              "type": "equation_inline",
              "content": "\\mathbf{f}(\\mathbf{n}) = \\Omega(\\mathbf{g}(\\mathbf{n}))"
            },
            {
              "type": "text",
              "content": " A. 对所有n > 1，均有 "
            },
            {
              "type": "equation_inline",
              "content": "\\mathbf{f}(\\mathbf{n}) \\leq 4\\mathbf{g}(\\mathbf{n})"
            },
            {
              "type": "text",
              "content": " B. "
            },
            {
              "type": "equation_inline",
              "content": "\\operatorname* { l i m } _ { n \\to \\infty } { \\frac { f ( n ) } { g ( n ) } } = 0"
            },
            {
              "type": "text",
              "content": " C. 对所有n > 123，均有 "
            },
            {
              "type": "equation_inline",
              "content": "\\mathbf{f}(\\mathbf{n}) \\geq 4\\mathbf{g}(\\mathbf{n})"
            },
            {
              "type": "text",
              "content": " D. 以上皆不是"
            }
          ]
        },
        {
          "type": "text",
          "index": 12,
          "bbox": [
