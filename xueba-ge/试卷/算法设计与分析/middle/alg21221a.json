            {
              "type": "text",
              "content": " "
            },
            {
              "type": "equation_inline",
              "content": "g(n) = \\log_2(n^4)"
            },
            {
              "type": "text",
              "content": " A "
            },
            {
              "type": "equation_inline",
              "content": "f   =   O ( g )"
            },
            {
              "type": "text",
              "content": " B. "
            },
            {
              "type": "equation_inline",
              "content": "f   =   \\Omega ( g )"
            },
            {
              "type": "text",
              "content": " C. "
            },
            {
              "type": "equation_inline",
              "content": "f   =   \\Theta ( g )"
