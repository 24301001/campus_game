        },
        {
          "type": "code",
          "index": 2,
          "bbox": [
            0.142,
            0.136,
            0.885,
            0.851
          ],
          "content": [
            {
              "type": "code_body",
              "index": 2,
              "bbox": [
                0.142,
                0.136,
                0.885,
                0.851
              ],
              "content": "（1）（共5分，每个1分；多写不正确的每个扣1分，最多扣5分。）\n(2,1), (3,1), (8,1), (6,1), (8,6)\n（2）（8分）参考伪代码如下所示。\n初始调用：\nInvCount(A[1..n]):\nreturn Count(A, 1, n)\nCount(A, left, right): //统计A[left..mid]的逆序对数量\nif left ≥ right then return 0 //区间长度≤1，逆序对数为0\nmid ← |(left + right) / 2|\nS left ← Count(A, left, mid) //左半部分逆序对数\nS right ← Count(A, mid + 1, right) //右半部分逆序对数\nS_cross ← MergeCount(A, left, mid, right) //跨越两部分的逆序对数\nreturnS left + S right + S cross\nMergeCount(A, left, mid, right):\n∥/先把待合并区间复制到辅助数组 B\nB[left..right] ← A[left..right]\ni ← left, j ← mid + 1, k ← left, S ← 0\nwhilei ≤ mid andj ≤ right do\nif B[i]≤ B[j] then //无逆序对，直接复制\nA[k] ← B[i]\ni ← i + 1\nelse //出现跨区间逆序对\nA[k] ← B[j]\nS ← S + (mid − i + 1) ∥/B[i..mid]均大于 B[j]\nj←j+ 1\nk ← k + 1,\nend while\n//复制剩余元素（最多一侧有元素未合并）\nif i ≤ mid then A[k..right] ← B[i..mid] else A[k..right] ← B[j..right]\nreturn S //返回跨区间逆序对数"
            }
          ],
          "sub_type": "code",
          "guess_lang": "txt"
        },
        {
          "type": "text",
          "index": 3,
          "bbox": [
            0.103,
            0.865,
            0.896,
            0.909
          ],
          "content": [
            {
              "type": "text",
              "content": "备注:分治结构正确得4分；能在线性时间内完成归并——即总体复杂度为O(n1g n)，再得4分。写出O(n2)或O(nlg2n)时间伪代码者，此处可得5分。"
            }
          ]
        },
