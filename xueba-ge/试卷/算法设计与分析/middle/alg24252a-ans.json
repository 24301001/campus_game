          "content": [
            {
              "type": "algorithm_body",
              "index": 4,
              "bbox": [
                0.184,
                0.169,
                0.586,
                0.302
              ],
              "content": [
                {
                  "type": "text",
                  "content": "将所有任务 "
                },
                {
                  "type": "equation_inline",
                  "content": "a _ { i }"
                },
                {
                  "type": "text",
                  "content": " 依处理时间 "
                },
                {
                  "type": "equation_inline",
                  "content": "p _ { i }"
                },
                {
                  "type": "text",
                  "content": " 的不增顺序排序\ntime ← 0 //当前时刻\ntotal ← 0 ∥/完成时刻之和\nfori← 1 to n\ntime ← time + pi, total ← total + time\nreturn total/n ∥/平均完成时刻"
                }
