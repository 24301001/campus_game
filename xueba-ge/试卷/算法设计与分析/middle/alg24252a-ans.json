              "content": " ，它们的完成时刻分别为 "
            },
            {
              "type": "equation_inline",
              "content": "{ { \\bf \\nabla } } ^ { \\prime } C _ { j } { } ^ { \\prime } = t + p _ { j } , C _ { i } { } ^ { \\prime } = t + p _ { j } + p _ { i }   ."
            }
