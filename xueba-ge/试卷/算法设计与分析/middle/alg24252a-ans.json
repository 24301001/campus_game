          ],
          "content": [
            {
              "type": "text",
              "content": "令 "
            },
            {
              "type": "equation_inline",
              "content": "m = \\log _ { 2 } n"
            },
            {
              "type": "text",
              "content": " ，则 "
            },
            {
              "type": "equation_inline",
              "content": "T ( n ) = T ( 2 ^ { m } )"
            },
