          "sub_type": "algorithm"
        },
        {
          "type": "text",
          "index": 5,
          "bbox": [
            0.105,
            0.306,
            0.894,
            0.374
          ],
          "content": [
            {
              "type": "text",
              "content": "（3）（共4分）假设在某个调度中，有两个任务 "
            },
            {
              "type": "equation_inline",
              "content": "\\cdot a _ { i }"
            },
            {
              "type": "text",
              "content": " 和 "
            },
            {
              "type": "equation_inline",
              "content": "i a _ { j }"
            },
            {
              "type": "text",
              "content": " ，且 "
            },
            {
              "type": "equation_inline",
              "content": ". p _ { i } > p _ { j }"
            },
            {
              "type": "text",
              "content": " ，但调度中却先执行了 "
            },
            {
              "type": "equation_inline",
              "content": "a _ { i }"
            },
            {
              "type": "text",
              "content": " 再执行 "
            },
            {
              "type": "equation_inline",
              "content": "a _ { j }"
            },
            {
              "type": "text",
              "content": " ；那么此调度中，一定有两个相邻任务 "
            },
            {
              "type": "equation_inline",
              "content": "a _ { i }"
            },
            {
              "type": "text",
              "content": " 和 "
            },
            {
              "type": "equation_inline",
              "content": "a _ { j }"
            },
            {
              "type": "text",
              "content": " 满足 "
            },
            {
              "type": "equation_inline",
              "content": "p _ { i } > p _ { j }"
            },
            {
              "type": "text",
              "content": " ，但先执行了 "
            },
            {
              "type": "equation_inline",
              "content": "a _ { i }"
            },
            {
              "type": "text",
              "content": "再执行 "
            },
            {
              "type": "equation_inline",
              "content": "\\therefore a _ { j }"
            },
            {
              "type": "text",
              "content": " (学生可直接使用此结果而无需证明。)"
            }
          ]
        },
        {
          "type": "text",
          "index": 6,
          "bbox": [
            0.145,
            0.379,
            0.552,
            0.397
          ],
          "content": [
            {
              "type": "text",
              "content": "我们比较调度顺序（假设t为 "
            },
            {
              "type": "equation_inline",
              "content": "a _ { i }"
            },
            {
              "type": "text",
              "content": " 的开始时刻):"
            }
          ]
        },
        {
          "type": "text",
          "index": 7,
          "bbox": [
            0.146,
            0.403,
            0.823,
            0.421
          ],
          "content": [
            {
              "type": "text",
              "content": "顺序一:先 "
            },
            {
              "type": "equation_inline",
              "content": "\\cdot a _ { i }"
            },
            {
              "type": "text",
              "content": " 后 "
            },
            {
              "type": "equation_inline",
              "content": "a _ { j }"
            },
            {
              "type": "text",
              "content": " ，它们的完成时刻分别为 "
            },
            {
              "type": "equation_inline",
              "content": "\\begin{array} { r } { { : } C _ { i } = t + p _ { i } , C _ { j } = t + p _ { i } + p _ { j } { \\mathrm {  。  } } } \\end{array}"
            }
          ]
        },
        {
          "type": "text",
          "index": 8,
          "bbox": [
            0.146,
            0.426,
            0.833,
            0.446
          ],
          "content": [
            {
              "type": "text",
              "content": "顺序二:先 "
            },
            {
              "type": "equation_inline",
              "content": "\\mathrm { i } a _ { j }"
            },
            {
              "type": "text",
              "content": " 后 "
            },
            {
              "type": "equation_inline",
              "content": "a _ { i }"
