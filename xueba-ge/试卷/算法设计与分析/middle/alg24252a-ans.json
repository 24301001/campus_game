          ],
          "content": [
            {
              "type": "text",
              "content": "记 "
            },
            {
              "type": "equation_inline",
              "content": "S ( m ) = T ( 2 ^ { m } )"
            },
            {
              "type": "text",
              "content": " ，原式等价于 "
            },
            {
              "type": "equation_inline",
              "content": "S(m)=2S(m/2)+m,S(0)=1 。"
            },
            {
              "type": "text",
              "content": " (至此2 分)"
