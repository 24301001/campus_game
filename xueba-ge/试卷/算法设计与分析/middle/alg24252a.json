          ],
          "content": [
            {
              "type": "text",
              "content": "(1) 递归式 "
            },
            {
              "type": "equation_inline",
              "content": "\\begin{array} { r } { \\mathrm { i } T ( n ) = T \\left( \\frac { n } { 2 } \\right) + \\Theta ( 1 ) } \\end{array}"
            },
            {
              "type": "text",
              "content": " 的解是（ )。A. Θ(n) B. Θ(lg n) C. "
            },
            {
              "type": "equation_inline",
              "content": "\\Theta ( n ^ { 2 } )"
            },
            {
              "type": "text",
              "content": " D. "
            },
            {
              "type": "equation_inline",
              "content": "\\Theta ( { \\sqrt { n } } )"
            }
