            0.521,
            0.751,
            0.605
          ],
          "content": [
            {
              "type": "text",
              "content": "(2) 以下增长率从慢到快的正确排列是（ )。A. "
            },
            {
              "type": "equation_inline",
              "content": "n \\lg n , n ^ { 2 } , n ! , 2 ^ { n }"
            },
            {
              "type": "text",
              "content": " B. "
            },
            {
              "type": "equation_inline",
              "content": "n , \\lg n , n \\lg n , n ^ { 2 }"
            },
            {
              "type": "text",
              "content": " C. "
            },
            {
              "type": "equation_inline",
              "content": "\\lg n , n , n \\lg n , n ^ { 2 }"
            },
            {
