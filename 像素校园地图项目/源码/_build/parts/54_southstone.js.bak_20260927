/* =========================================================
   5.4 南门校名石 + 石狮 —— 按 建筑物照片/南门.jpg 还原
   ---------------------------------------------------------
   用户：「这个北京交通大学名字的石碑是在我们画的南门右边，字体其实就是那个
   font照片里的字体，不过是黄色的，学习一下这个石碑怎么画的，还有一个石狮子，
   进行还原」。

   照片里是**两件东西**：
     ① 校名石：一圈**毛面花岗岩块石**砌成的门字形石框，框内嵌一大块**磨光红石板**；
        红石板上半是六个**金色毛笔字「北京交通大学」**，下半贴一行**金色英文**
        「BEIJING JIAOTONG UNIVERSITY」。
     ② 石狮：蹲坐的青石狮，前爪踏绣球，坐在三级台基上，位于石碑**左前方**。

   三件事必须说清楚：

   【一】字不是重画的。§5.4.2 的六个点阵直接取自 §4.9 那块生成块（`SG_ROW6`）——
   与南门拱上的四个金字**同一串字节、同一个高度 28px**，只是这边不旋转、排成一行。
   生成器 `_build/_glyphs.py` 为此多描了「北」「京」两个字（拱只用得到「交通大学」），
   并把切字判据从"列投影最小的一列"改成了"离理论位置最近的零墨游程" —— 旧判据会从
   「北」自己的 丬/匕 中间切下去（那条缝比字间的缝还宽），切出来的「北」只剩半个。
   拱上的 `SG_CHARS` 四个数一个没变，产物里也逐字节不变。

   【二】英文那行没有现成字形可用。行书毛笔字点阵里没有拉丁字母，而系统字体在这个
   尺寸下（帽高 7px、整行 153px）二值化之后会糊成一团。所以 §5.4.3 手写了一副
   **5×7 点阵大写字母**（只做这句话用到的 14 个字母）—— 这是像素风里的标准做法，
   和「把字变成点阵再逐像素填色」的既有路子一致（§3.0 屋名标牌、§4.9 校名）。

   【三】位置在南门（G2）**东侧**，且与门拱**共用同一条落地线**。
   用户说的"右边"按地图方位 = 屏幕右 = 世界 x 大的一侧；"和拱形南门根部 y 轴高度一致"
   就是取 `GATES` G2 的 y（= `IX(6.3750)` = 2490.02）—— 49 段给拱门 addProp 时用的
   正是同一个表达式，所以碑 / 狮 / 拱三者的 baseY 完全同源（G2 挪了它们跟着挪）。
   剖面（`_gt.py 2100 2280 2520 2560`）：y2400..2491 是砖石路面，2496 起是界外 ⇒
   这条线正好是校园最南的一条可通行路面，碑与狮贴着围墙内侧站。
   石狮从"碑的左前方"改到"碑的正西、同一条落地线上"（用户 2026-09-13 选定）——
   落地线已经贴到围墙，南边再没有摆狮子的余地，并排站既保住量感也读得出是**一对**。
   ⚠️ 用户随后又追加「再往左移动一下，靠近拱形南门」：整组（狮 + 碑）**整体西移 66px**
      （碑心 2270 → 2204、狮心 2196 → 2130）。能挪多远由**地面**决定、不是审美：
      砖石/沥青 的分界线在 x2112，狮子的西缘（2116）只能压到那儿为止 —— 再往西
      狮子就站进门洞里那条车道了；同时还要避开拱门画布的东缘（x2102）。

   【四】尺寸是**用户 2026-09-13 追加要求「大小变为原来的一半」**。成品：碑 102×63、
   狮 28×46（`SM_DW/SM_DH`、`SL_DW/SL_DH`）。两只精灵走的**是两条路**，不是一条：

   * **校名石 —— 画完 204×126，再 `halfSprite()` 降一半。**
     牌面是一块平涂的红石板，2×2 抽样不掉信息；⚠️ 不能改用 `drawImage` 缩小：
     那是隔行隔列抽样，1px 的亮棱 / 描边会被**整根抽掉**。
     ⚠️⚠️ 六个金字**例外**：它们不跟着 `halfSprite` 抽，而是先 `sgHalf()` 把
     49 段那串 1-bit 掩膜按覆盖率（≥ 2/4）降到半尺寸，再点到 already-halved 的
     画布上。跟着一起抽会把「通」的辶抽断、「学」抽成糊团（实测）。
     详见 §5.4.1b / §5.4.2。

   * **石狮 —— 不降采样，直接按 28×46 重画。**
     狮子的细节密度（r3~r5 的卷毛、1px 亮棱、风化亮斑）是照 56×92 定的，
     降采样后无论是就近抽样还是取离群色都读不出狮形（实测两版：一版糊成抹布、
     一版被亮斑放大成电视雪花）。详见 §5.4.8 头注。

   【五】英文那行**按用户决定去掉了**（同日三选一里选的"去掉英文，只留中文六字"）。
   红石板减半后只剩 90px 宽，而「BEIJING JIAOTONG UNIVERSITY」26 个字符在 1:1 下
   占 153px —— 就算把字压到 3px 宽、字间不留缝也才勉强 78px（字母会全贴死）。
   §5.4.3 那副手写 5×7 拉丁字体与 `smText()` **留在文件里备用**（想加回来直接用，
   `build.py` 的契约不删它），但当前**没有任何调用点**。
   ========================================================= */

/* --- 5.4.1 几何常量 ---
   全部由「红石板」推出来：照片里这块红石板是个横放的长方形，花岗岩框的厚度
   大约是石板高度的 0.13（透视放大了近侧，照抄会把框做成一堵墙）。 */
const SM_FRAME = 13;                              // 毛面花岗岩框厚（四边同厚）
const SM_SLAB_W = 178, SM_SLAB_H = 100;           // 红石板
const SM_W = SM_SLAB_W + SM_FRAME * 2;            // 204 ← **设计尺寸**，绘制全按它来
const SM_H = SM_SLAB_H + SM_FRAME * 2;            // 126
const SM_DW = SM_W >> 1, SM_DH = SM_H >> 1;       // 102×63 ← **成品尺寸**（§5.4.1b 减半）
/* 碑心 x2204（画布横跨 2153..2255）；落地线 = 南门拱根的 y —— 用与 49 段
   `props.push({... y: G.y})` 完全相同的表达式，两者永远不会脱节。
   ⚠️ x 是**用户两轮往西推**的结果（2270 → 2204，靠近拱门）：
      西边那条 砖石/沥青 分界线在 **x2112**（`_gt.py 2032 2112 2440 2512`：y2480 那行
      x2032..2111 是沥青路面、x2112 起才是砖石），所以整组（狮 + 碑）**最西只能**到
      狮的西缘 2116 —— 再往西狮子就站到门洞里那条车道上了。 */
const SM_X = 2204, SM_BY = IX(6.3750);            // 碑心世界 x / 落地线世界 y

/* 石狮：蹲坐像，坐在三级台基上。**34×62** —— 尺寸按**照片实测的比例**反推：
   实拍里石狮（含台基）的包围盒是 440×810（宽:高 = 1:1.84），而校名石在游戏里
   63 高 ⇒ 狮子 62 高正好"与碑齐肩"，也符合照片里"狮子高到石框下沿"的量感。
   ⚠️ 这个尺寸**不是"当初 56×92 的一半"**（那是 28×46，1:1.64，比真狮子矮胖）。
      用户 2026-09-13 报"画的效果太差"，根因就是 28×46：那点面积放不下石狮
      赖以成形的细节（卷毛 / 亮棱 / 绣球 / 皮孔），被迫"减特征"之后只剩个轮廓。
      放大到 34×62 后面积是原来的 1.66 倍，细节按 §5.4.8 头注那张清单逐条加回来。 */
const SL_DW = 34, SL_DH = 62;                     // 成品尺寸 = 唯一的绘制尺寸
/* 狮心 x2128：成品半宽 17 ⇒ 横跨 2111..2145。
   西侧 8px 到南门拱的东柱面（实测：拱的不透明像素顶到 x2103，画布框是 2103 而非
   README 早先写的 2102）、东侧 8px 到碑的左框（2153）—— **两侧各 8px，是这个口袋
   里能放下的最大宽度**：从拱柱面 2103 到校名石西沿 2153 一共只有 50px。
   ⚠️ 落地线与碑**完全相同**（并排站，见头注【三】）⇒ 两个 baseY 相等，
      谁都不会把对方压掉；水平上又不重叠，画序无关紧要。 */
const SL_X = 2128, SL_BY = SM_BY;

/* --- 5.4.1b 整只精灵减半（用户「大小变为原来的一半」的唯一实现） ---
   石框 + 石板这类**实心色块**走这里：2×2 取块，输出 alpha = 块内最大 alpha
   （软影不会变淡），颜色取实心样本里最先遇到的那个（为什么不用更聪明的规则，
   见函数内那段注）。
   ⚠️ 唯一**不能**走这里的是**金字**：笔画只有 1-2px，就近抽样必然糊、
      `drawImage` 缩更会把细笔画整根抹掉 —— 金字用 `sgHalf()` 从点阵按覆盖率
      直接降到一半，点在降半之后的画布上（见 §5.4.7）。 */
function halfSprite(src) {
  const sw = src.width, sh = src.height, w = sw >> 1, h = sh >> 1;
  const d = src.getContext("2d").getImageData(0, 0, sw, sh).data;
  const out = mkCanvas(w, h), g = out.getContext("2d");
  for (let y = 0; y < h; y++) {
    for (let x = 0; x < w; x++) {
      /* 2×2 块的四个样本下标（行优先：左上 / 右上 / 左下 / 右下） */
      const i0 = (y * 2 * sw + x * 2) * 4;
      const q = [i0, i0 + 4, i0 + sw * 4, i0 + sw * 4 + 4];
      let a = 0;
      for (const i of q) if (d[i + 3] > a) a = d[i + 3];
      if (a < 24) continue;                              // 整块几乎全空 ⇒ 不落笔
      /* 颜色取"实心样本里最先遇到的那个"。
         ⚠️⚠️ 试过更聪明的规则，全都**更糟**，写在这里免得后人再走一遍：
            ① 取"离块内均值色最远的样本"（想保住亮棱/描边这类离群色）——
               它把**抖点层**也一起放大了：`speckle()` 撒的几十颗亮斑在 4 个样本里
               天然是离群色、必然胜出，半尺寸下密度是设计尺寸的 4 倍
               （石板 107 颗金点、狮身 46 颗白霜），成品直接变成电视雪花。
            ② `drawImage` 直接缩小 —— 隔行隔列抽样，1px 的亮棱整根消失。
        所以规则就一条：**软影看 alpha、实心区域就近取一个样本**。
        真正需要抗抽样的只有**金字**，那是另一条路：不参与降采样，
        在降半之后的画布上用 `sgHalf()` 直接点（见 §5.4.7）。 */
      const ci = q[0];
      g.fillStyle = "rgba(" + d[ci] + "," + d[ci + 1] + "," + d[ci + 2] + "," + (a / 255) + ")";
      g.fillRect(x, y, 1, 1);
    }
  }
  return out;
}
/* 1bit 点阵减半（金字专用）：2×2 块**覆盖率 ≥ 2/4** 才留墨。
   一条 1px 的笔画在每个 2×2 块里恒占 2/4 ⇒ 原样保留；孤立单点（1/4）丢掉
   —— 这正是"半尺寸下该有的笔画"。⚠️ 真正的隔行抽样会把细笔画整根抹掉，
   所以金字**绝不能**走 halfSprite（那是给实心色块用的）。 */
function sgHalf(b64, nw, nh) {
  const src = sgBits(b64, nw * nh), w = Math.ceil(nw / 2), h = Math.ceil(nh / 2);
  const m = new Uint8Array(w * h);
  for (let y = 0; y < h; y++) for (let x = 0; x < w; x++) {
    const x0 = Math.round(x * nw / w), x1 = Math.max(x0 + 1, Math.round((x + 1) * nw / w));
    const y0 = Math.round(y * nh / h), y1 = Math.max(y0 + 1, Math.round((y + 1) * nh / h));
    let ink = 0, tot = 0;
    for (let sy = y0; sy < y1 && sy < nh; sy++)
      for (let sx = x0; sx < x1 && sx < nw; sx++) { tot++; if (src[sy * nw + sx]) ink++; }
    m[y * w + x] = (ink * 2 >= tot) ? 1 : 0;
  }
  return { m: m, w: w, h: h };
}

/* --- 5.4.2 用色（全部取 南门.jpg 的中位色，见 _samp.py 取样） --- */
const SM_GOLD_L = "#f2de8e", SM_GOLD = "#d8b868", SM_GOLD_D = "#8a6624";
const SM_GRAN_L = "#a49c93", SM_GRAN = "#8a8279", SM_GRAN_D = "#6b655d", SM_GRAN_S = "#565048";
const SM_RED_L = "#7d564c", SM_RED = "#684038", SM_RED_D = "#563129", SM_RED_S = "#45261e";
/* 石狮的青石：照片里被风雨蚀成**中性偏冷的灰绿**（不是蓝灰）——
   亮面是起霜的浅灰绿，暗面接近墨绿黑。取色见 南门.jpg 的狮身中位色。 */
const SL_HI = "#a9b2a9", SL_L = "#8b968f", SL_M = "#66716b", SL_D = "#454e49", SL_S = "#2b322e";
const SL_BASE_L = "#828a84", SL_BASE_D = "#5b6360", SL_DARK = "#2e3431", SL_DARK_D = "#202521";

/* --- 5.4.3 5×7 点阵大写字母 ---
   只做「BEIJING JIAOTONG UNIVERSITY」用得到的 14 个字母 + 空格。
   每格 5 宽 7 高，字距 1（advance 6），空格 3 —— 整行 153px，原红石板 178 宽，
   左右各留 12px，与照片里英文几乎顶满石板的观感一致。
   ⚠️ **2026-09-13 起没有任何调用点**：石碑减半后石板只剩 90px 宽，这行 153px
      塞不进去，用户选择「去掉英文，只留中文六字」。字形与 `smText()` 留着备用
      （想加回来直接调，`build.py` 的契约不删它 —— 手写的表比系统字体二值化干净）。 */
const SM_FONT = {
  B: ["####.", "#...#", "#...#", "####.", "#...#", "#...#", "####."],
  E: ["#####", "#....", "#....", "####.", "#....", "#....", "#####"],
  I: ["#####", "..#..", "..#..", "..#..", "..#..", "..#..", "#####"],
  J: ["....#", "....#", "....#", "....#", "#...#", "#...#", ".###."],
  N: ["#...#", "##..#", "##..#", "#.#.#", "#..##", "#..##", "#...#"],
  G: [".###.", "#...#", "#....", "#..##", "#...#", "#...#", ".###."],
  A: [".###.", "#...#", "#...#", "#####", "#...#", "#...#", "#...#"],
  O: [".###.", "#...#", "#...#", "#...#", "#...#", "#...#", ".###."],
  T: ["#####", "..#..", "..#..", "..#..", "..#..", "..#..", "..#.."],
  U: ["#...#", "#...#", "#...#", "#...#", "#...#", "#...#", ".###."],
  S: [".####", "#....", "#....", ".###.", "....#", "....#", "####."],
  Y: ["#...#", "#...#", ".#.#.", "..#..", "..#..", "..#..", "..#.."],
  R: ["####.", "#...#", "#...#", "####.", "#.#..", "#..##", "#...#"],
  V: ["#...#", "#...#", "#...#", "#...#", ".#.#.", ".#.#.", "..#.."]
};
const SM_TEXT = "BEIJING JIAOTONG UNIVERSITY";
const SM_ADV = 6, SM_GLYPH_W = 5, SM_SP = 3;
const SM_TEXT_W = (() => {
  let w = 0;
  for (const ch of SM_TEXT) w += (ch === " " ? SM_SP : SM_ADV);
  return w - 1;
})();                                             // 153

/* --- 5.4.4 金字：点阵 → 逐像素落笔（带 1px 斜面） ---
   §4.9 的 sgGlyph 是"沿拱的切线旋转 + 裁进拱轮廓"专用的；这里不旋转也不裁，
   但要求**立体金字**（照片里的字是凸起的，左下压暗、左上提亮），所以单写一个：
     fill  —— 字面；
     edge(ox,oy) —— 沿 (ox,oy) 方向的 1px 外边，用位移邻居反查，只落在外轮廓上。
   ⚠️ 提亮边取的是**左上**（ox=-1,oy=-1 ⇒ 查右下邻居有没有墨），压暗边取**右下**。 */
function smStamp(g, m, nw, nh, x0, y0, col) {
  for (let y = 0; y < nh; y++)
    for (let x = 0; x < nw; x++)
      if (m[y * nw + x]) px(g, x0 + x, y0 + y, 1, 1, col);
}
function smGold(g, m, nw, nh, x0, y0) {
  const hit = (x, y) => (x >= 0 && y >= 0 && x < nw && y < nh && m[y * nw + x]) ? 1 : 0;
  const lit = [], dark = [];
  for (let y = -1; y <= nh; y++) {
    for (let x = -1; x <= nw; x++) {
      if (hit(x, y)) continue;
      if (hit(x + 1, y + 1)) lit.push(x, y);       // 本格空、右下有墨 ⇒ 左上边
      if (hit(x - 1, y - 1)) dark.push(x, y);      // 本格空、左上有墨 ⇒ 右下边
    }
  }
  for (let i = 0; i < lit.length; i += 2) px(g, x0 + lit[i], y0 + lit[i + 1], 1, 1, SM_GOLD_L);
  smStamp(g, m, nw, nh, x0, y0, SM_GOLD);
  for (let i = 0; i < dark.length; i += 2) px(g, x0 + dark[i], y0 + dark[i + 1], 1, 1, SM_GOLD_D);
}
/* 英文那行：5×7 太细，压斜边会糊，只填一个偏亮的金 —— 照片里这行也比中文更亮。
   ⚠️ 当前无调用点（见 §5.4.3 的注）。 */
function smText(g, s, x0, y0, col) {
  let x = x0;
  for (const ch of s) {
    if (ch === " ") { x += SM_SP; continue; }
    const rows = SM_FONT[ch];
    for (let y = 0; y < rows.length; y++)
      for (let i = 0; i < SM_GLYPH_W; i++)
        if (rows[y][i] === "#") px(g, x + i, y0 + y, 1, 1, col);
    x += SM_ADV;
  }
}

/* --- 5.4.5 毛面花岗岩框 ---
   石块砌法：横缝通长、竖缝错缝。框只有 13px 厚 ⇒ 上下两条带各两皮（6/7px），
   左右两条带按 18px 一皮。每块石头左上受光、右下背光（1px），再撒一层颗粒
   —— 照片里这块墙的"毛面"就靠这三件事读出来。 */
function smBlockBand(g, x0, y0, w, h, rows, rng) {
  px(g, x0, y0, w, h, SM_GRAN);
  const rh = h / rows;
  for (let r = 0; r < rows; r++) {
    const ry = y0 + Math.round(r * rh), rb = y0 + Math.round((r + 1) * rh) - 1;
    const off = (r % 2) * 17;
    for (let x = x0 + off; x < x0 + w; x += 34) {
      px(g, Math.max(x0, x), ry, 1, rb - ry + 1, SM_GRAN_S);          // 竖缝
      if (x > x0) px(g, Math.max(x0, x) - 1, ry, 1, rb - ry + 1, SM_GRAN_L);  // 缝右的受光棱
    }
    px(g, x0, rb, w, 1, SM_GRAN_S);                                    // 横缝
    px(g, x0, ry, w, 1, SM_GRAN_L);                                    // 每皮上棱受光
  }
  px(g, x0, y0, w, 1, SM_GRAN_L);                                      // 顶棱
  px(g, x0, y0 + h - 1, w, 1, SM_GRAN_D);                              // 底棱
  speckle(g, x0, y0, w, h, SM_GRAN_L, Math.round(w * h * 0.035), rng);
  speckle(g, x0, y0, w, h, SM_GRAN_D, Math.round(w * h * 0.030), rng);
}
function smBlockCol(g, x0, y0, w, h, rng) {
  px(g, x0, y0, w, h, SM_GRAN);
  for (let y = y0; y < y0 + h; y += 18) {
    px(g, x0, y, w, 1, SM_GRAN_L);                                     // 每皮上棱
    px(g, x0, Math.min(y0 + h - 1, y + 17), w, 1, SM_GRAN_S);          // 下缝
  }
  px(g, x0, y0, 1, h, SM_GRAN_L);                                      // 左棱受光
  px(g, x0 + w - 1, y0, 1, h, SM_GRAN_D);                              // 右棱背光
  speckle(g, x0, y0, w, h, SM_GRAN_L, Math.round(w * h * 0.05), rng);
  speckle(g, x0, y0, w, h, SM_GRAN_S, Math.round(w * h * 0.05), rng);
}

/* --- 5.4.6 磨光红石板 ---
   照片里的红石板是抛光面：上缘有一道天光反射（亮），左上角映着树影（暗），
   板面还看得见拼缝。三样都画，但都压得很淡 —— 稍重一点就会盖住金字。 */
function smSlab(g, x0, y0, w, h, rng) {
  px(g, x0, y0, w, h, SM_RED);
  for (let i = 0; i < h; i++) {                                        // 上亮下暗的竖向渐变
    const k = (1 - i / h);
    px(g, x0, y0 + i, w, 1, mix(SM_RED_D, SM_RED_L, 0.18 + k * 0.34));
  }
  /* ⚠️ 反射/树影一律压到 0.2 以下：石板只有 100px 高，而金字要压在它上面 ——
     影子的 alpha 稍大一点，放大看就是两块脏抹布，还会把金字衬得发灰。 */
  ellipsePx(g, x0 + w * 0.30, y0 + h * 0.24, w * 0.30, h * 0.30, rgba(SM_RED_D, 0.20));   // 树影
  ellipsePx(g, x0 + w * 0.22, y0 + h * 0.16, w * 0.18, h * 0.22, rgba(SM_RED_S, 0.15));
  ellipsePx(g, x0 + w * 0.80, y0 + h * 0.72, w * 0.22, h * 0.26, rgba(SM_RED_L, 0.10));   // 右下返光
  px(g, x0 + Math.round(w * 0.62), y0, 1, h, rgba(SM_RED_S, 0.5));                        // 拼缝
  px(g, x0, y0 + Math.round(h * 0.66), w, 1, rgba(SM_RED_S, 0.34));
  speckle(g, x0, y0, w, h, rgba(SM_RED_L, 0.5), Math.round(w * h * 0.006), rng);
  px(g, x0, y0, w, 1, rgba(SM_RED_L, 0.55));                            // 上缘天光
  px(g, x0, y0 + h - 1, w, 1, SM_RED_S);
  px(g, x0 + w - 1, y0, 1, h, SM_RED_S);
}

/* --- 5.4.7 整块校名石 ---
   全部按**设计尺寸**（204×126）画，最后一步 `halfSprite()` 降到 102×63。
   板面上只有中文六字一行（英文按用户决定去掉了，见头注【五】）。 */
function makeSchoolStone() {
  const c = mkCanvas(SM_W, SM_H + 5), g = c.getContext("2d");
  const rng = makeRng(54401);
  const F = SM_FRAME, SW = SM_SLAB_W, SH = SM_SLAB_H;
  /* 框：上下两条横带各两皮，左右两条竖带按 18px 一皮 */
  smBlockBand(g, 0, 0, SM_W, F, 2, rng);
  smBlockBand(g, 0, F + SH, SM_W, F, 2, rng);
  smBlockCol(g, 0, F, F, SH, rng);
  smBlockCol(g, F + SW, F, F, SH, rng);
  /* 石板嵌进去：先在框上压一圈暗缝（石板比框低，接缝必须看得见），再画板面 */
  px(g, F, F, SW, SH, SM_RED_S);
  smSlab(g, F, F, SW, SH, rng);
  px(g, F - 1, F - 1, SW + 2, 1, rgba(SM_GRAN_S, 0.55));               // 框压石板的投影
  px(g, F - 1, F - 1, 1, SH + 2, rgba(SM_GRAN_S, 0.55));
  /* 落地：石框自身的接地暗带 + 地上的软影（往南 5 行，两层递淡） */
  px(g, 0, SM_H - 1, SM_W, 1, rgba(SM_GRAN_S, 0.75));
  shadowBlob(g, SM_W / 2, SM_H + 2, SM_W * 0.54, 4, 0.30, 3);

  /* --- 减半，然后**在半尺寸上点金字** ---
     ⚠️ 顺序是硬的：金字必须在 `halfSprite()` **之后**画。之前是"一起降采样"，
        28px 的笔画降成 14px 之后「通」的辶、「学」的上半截全都糊掉了
        （`_propview.py` 8× 一眼就看出来）。 */
  const out = halfSprite(c), g2 = out.getContext("2d");
  const HF = SM_FRAME >> 1;                       // 半尺寸下的框厚：13 → 6
  const SH2 = SM_DH - HF * 2;                     // 半尺寸下的石板高：63 − 12 = 51
  /* 中文六字一行：字高 14（= 28 的一半），字距 2，整块板上居中 */
  const GAP = 2;
  const hs = SG_ROW6.map(cs => sgHalf(cs[0], cs[1], cs[2]));
  let tw = hs.reduce((s, h) => s + h.w, 0) + GAP * (hs.length - 1);
  let tx = Math.round((SM_DW - tw) / 2);
  const ty = HF + Math.round((SH2 - hs[0].h) / 2);
  for (const h of hs) {
    smGold(g2, h.m, h.w, h.h, tx, ty);
    tx += h.w + GAP;
  }
  /* 锚点也减半：ax 51 / ay 63 就是成品的中心与落地线 */
  return { canvas: out, ax: SM_DW / 2, ay: SM_DH };
}

/* ---------------------------------------------------------
   5.4.8 石狮（**直接按成品 34×62 画**）
   ---------------------------------------------------------
   ⚠️⚠️ 石狮是**重画**出来的，不走 `halfSprite()`。第一版按 56×92 画完再降采样，
      成品在 `_propview.py`（8× 原精灵放大图）下是一坨读不出狮形的斑驳色块 ——
      两种 2×2 抽样规则都试过，各自死法不同：
        · 就近抽样 → r3~r5 的卷毛彼此咬死，鬃、眉、下颌卷须全糊成一块抹布；
        · 取"离群色" → 风化亮斑在各自的 2×2 块里恒为离群点、被逐颗放大成
          满身白点，整只狮子变成电视雪花。
      于是退成 28×46 重画。**但用户 2026-09-13 报「石狮子…画的效果太差了」。**
      复盘后的结论是：28×46 的毛病不在画技，在**面积** —— 那点像素放不下石狮
      赖以成形的细节（卷毛 / 亮棱 / 绣球 / 皮孔），只能被迫"减特征"，减完只剩轮廓。
   ⇒  这一版放大到 **34×62**（面积 ×1.66），把减掉的细节逐条加回来（清单见
      `makeStoneLion()` 头注）。尺寸不是拍脑袋：实拍照片里石狮（含台基）的包围盒
      是 440×810 = **1:1.84**，校名石成品 63 高 ⇒ 狮 62 高正好"与碑齐肩"，也符合
      照片里"狮高到石框下沿"的量感。34 则是那个口袋（x2103..2153 = 50px）减掉
      两侧各 8px 净空之后放得下的最大宽度。
      ⚠️ 别把 34×62 读成"28×46 的 1.2 倍"：两者比例不同（1:1.82 vs 1:1.64），
         28×46 那版是**偏矮胖**的，不是同一只狮子等比缩放。
   ---------------------------------------------------------
   画法（三层，与 §5.3 齿轮雕塑同一套路）：
     ① 底板：把整只狮子的**剪影**按要求逐块画出来（鬃毛 → 身体 → 腿 → 头 → 五官），
        全部平涂中间调 SL_M；
     ② 描边：slEdge() 从画布像素反查 —— 凡是"本格透明、邻居有墨"的格子按方向补 1px，
        左上补 SL_L（受光）、右下补 SL_D（背光）。整只狮子立刻有了体积，
        不必给每块单独算光。
     ③ 刻画：卷毛、鬃、眉眼、绣球孔、台基线脚 —— 这些是**形**不是光，
        必须手画，描边补不出来。
   ⚠️ slEdge 只能读一次、写完再读第二遍（两次方向不同），所以读→算→写要分三拍。
   ⚠️ ① 里那些**位移的实心形状**（暗底 + 上移 1px 的亮面）才是主要的光，
      ② 的 1px 描边只负责把整只从地上抠出来 —— 反过来依赖描边，34px 宽的面积
      上根本读不出体积。
   --------------------------------------------------------- */
/* 沿 (ox,oy) 给不透明区域补 1px 外边：本格透明、沿该方向有墨才落笔。
   ox=-1,oy=-1 ⇒ 查右下邻居 ⇒ 补出来的是**左上**的边。 */
function slEdge(g, w, h, ox, oy, col) {
  const d = g.getImageData(0, 0, w, h).data;
  const A = (x, y) => (x < 0 || y < 0 || x >= w || y >= h) ? 0 : d[(y * w + x) * 4 + 3];
  const pts = [];
  for (let y = 0; y < h; y++)
    for (let x = 0; x < w; x++)
      if (!A(x, y) && A(x + ox, y + oy) > 110) pts.push(x, y);
  g.fillStyle = col;
  for (let i = 0; i < pts.length; i += 2) g.fillRect(pts[i], pts[i + 1], 1, 1);
}
/* 一个卷毛：暗底环 + 卷面 + 一道"回勾"，读成螺旋而不是一颗珠子 ——
   石狮从头到脚最认得出的东西就是这一颗颗卷（鬃、眉、下颌的须、尾巴尖全是它）。 */
function slCurl(g, cx, cy, r, light) {
  circlePx(g, cx, cy, r, SL_D);
  circlePx(g, cx, cy, r - 1, light ? SL_L : SL_M);
  px(g, cx - 1, cy + r - 2, 2, 1, SL_D);             // 回勾
  px(g, cx - 1, cy - 1, 1, 1, SL_HI);                // 卷顶高光
}
/* 沿一段圆弧摆一排卷（角度用度、y 朝上，90° = 正上方）—— 鬃用。 */
function slCurlArc(g, cx, cy, arcR, a0, a1, n, r, squash) {
  const sq = squash === undefined ? 0.86 : squash;
  for (let i = 0; i < n; i++) {
    const t = i / (n - 1), a = (a0 + (a1 - a0) * t) * Math.PI / 180;
    slCurl(g, Math.round(cx + Math.cos(a) * arcR), Math.round(cy - Math.sin(a) * arcR * sq),
      r + (i % 2), i % 2 === 0);            // 大小交替 ⇒ 鬃不是一串等大的珠子
  }
}
/* 沿水平线摆一排卷、左右对称收窄 —— 下颌那挂"卷须"用（照片里是上宽下窄的一挂围脖）。
   ⚠️ 不能用 slCurlArc 画这个：圆弧的**最高点**在半圆的顶上，squash=1 时
      半径 15 的弧顶会落到 y=cy-15，正好糊在脸上（第一版就是这么把五官盖掉的）。 */
function slCurlRow(g, cx, y, halfW, n, r) {
  for (let i = 0; i < n; i++) {
    const t = n === 1 ? 0.5 : i / (n - 1);
    slCurl(g, Math.round(cx - halfW + 2 * halfW * t), y, r, i % 2 === 0);
  }
}
function makeStoneLion() {
  /* ⚠️⚠️ 石狮**直接按成品尺寸画**，不走 `halfSprite()` —— 实测两种 2×2 抽样规则
      都读不出狮形（就近抽样 → 卷毛咬死成一块抹布；取离群色 → 风化亮斑在各自的
      2×2 块里恒为离群点、被逐颗放大成满身白点，整只变电视雪花，见 §5.4.1b 注）。
      所以下面每个坐标都是**成品像素**，没有"设计尺寸"那一层。

      ⚠️ 这张"细节清单"是 34×62 相对 28×46 **加回来**的东西，以后再改尺寸照着核：
         鬃卷      4 颗 r2，只摆头顶       → 8 颗 r2/r3，绕脸一整圈（20°~160°）
         下颌卷须  3 颗 r3 + 2 颗 r2（珠）→ 5 道出挑的暗齿（半圆，不是珠子）
         风化亮斑  6，撒满整只            → 9，**只撒躯干**（撒到鬃上 = 雪人）
         绣球      4 个镂空孔             → r4 球 + 4 个孔 + 左前爪压在球顶上
         牙        1 排                   → 上下各 1 排（各 3 颗）
         脚爪趾    3 根/只                 → 4 根/只
         台基      三级、只有底线          → 三级 + 每级上棱提亮 / 级间压暗（线脚）
         前腿      三块同色中间挖黑缝      → 每条腿自带左亮右暗 + 2px 腿缝
         躯干凿痕  无                     → 5 颗深色小斑
         耳朵      —                      → **仍然没有**：34px 放不下，画了只剩斜刺。
                                            鬃上 20°/160° 那两颗 r3 大卷就是"耳"。 */
  const W = SL_DW, H = SL_DH;                        // 34 × 62
  const c = mkCanvas(W, H + 2), g = c.getContext("2d");
  const rng = makeRng(54402);
  const CX = W >> 1;                                 // 狮身中轴 = 17

  /* ---- ① 剪影 ----
     照片里各段的竖向占比如下（实拍包围盒 810px 高，按比例折到 62）：
       头带鬃 2..26（39%）/ 躯干 27..48（35%）/ 台基 48..62（22%）。
     这个"大头大鬃"的比例不能按正常动物改 —— 石狮就是头大鬃大。
     ⚠️ 明暗必须在第一步就用**位移的实心形状**定死，② 那圈 1px 描边只负责把
        整只从地上"抠"出来。像素风的规矩是**形状本身就是光**。

     ⚠️ 画序（改哪一步插哪儿都用这张表核）：
        台基 → 躯干 → 腿 → 尾巴 → 绣球 → 鬃底 → 鬃卷 → **脸** → 下颌卷须
        → 描边 → 五官/线脚/亮斑。
        鬃卷必须在脸**之前**（脸要把扫进五官区的半个卷盖掉），
        下颌卷须必须在脸**之后**（它是从下巴挂下来、压在胸口的）。 */
  /* 三级台基：狮子坐的那一级 / 深色磨光的一级 / 最宽的一级 */
  px(g, 9, 48, 16, 3, SL_M);
  px(g, 6, 51, 22, 4, SL_DARK);
  px(g, 3, 55, 28, 4, SL_BASE_L);
  /* 躯干：**一整块钟形**（肩 9..25、臀 5..29），不是几个圆叠起来
     ⚠️ 臀(24 宽) 必须**窄于鬃(30 宽)**：反过来就成了"身子比头大"的熊。 */
  poly(g, [[9, 27], [25, 27], [28, 40], [29, 48], [5, 48], [6, 40]], SL_M);
  poly(g, [[21, 27], [25, 27], [28, 40], [29, 48], [21, 48]], SL_D);   // 右半身背光
  ellipsePx(g, 9, 41, 6, 7, SL_L);                   // 左臀受光
  /* 前腿两根立柱 + 脚爪（x10..23 切成 腿6 / 缝2 / 腿6，整块居中在狮心 17）
     ⚠️ 每条腿**自己带左亮右暗**，缝只给 2px —— v2 是"三块同样亮的 SL_M 中间挖
        一道 3px 的 SL_S"，放大后那 3px 黑条读成了狮子胸前挂的一条领带，
        两条腿反而因为和躯干同色、完全看不出是腿。 */
  for (const lx of [10, 18]) {
    px(g, lx, 33, 6, 15, SL_M);
    px(g, lx, 33, 1, 15, SL_L);                      // 左缘受光
    px(g, lx + 5, 33, 1, 15, SL_D);                  // 右缘背光
  }
  px(g, 16, 33, 2, 15, SL_D);                        // 腿缝
  ellipsePx(g, 13, 47, 4, 2, SL_M);                  // 左脚爪
  ellipsePx(g, 21, 47, 4, 2, SL_M);                  // 右脚爪
  /* 尾巴：贴右臀外侧甩上来。
     ⚠️ 圆心必须**压在身躯轮廓上**：整颗摆在轮廓外面就成了一个悬空的疙瘩。 */
  circlePx(g, 28, 33, 3, SL_M);
  circlePx(g, 26, 27, 2, SL_M);
  /* 绣球：压在左前爪前面（照片里球就杵在左前腿根上，是透雕的）。
     ⚠️ 半径只给 4：r5/r6 那版球跟脸一样大，一眼看过去分不清哪边是头。
        球面**不能比身子亮**（整颗刷 SL_L 会把眼睛抢过去），所以是
        SL_S 环 + SL_M 面 —— 那圈 SL_S 正是把它从肚子上"切"出来的全部依据。 */
  circlePx(g, 10, 44, 4, SL_S);
  circlePx(g, 10, 44, 3, SL_M);
  px(g, 8, 43, 2, 1, SL_L);                          // 只留左上一点受光
  /* 左前爪压在球顶上（照片里是"脚踩绣球"，球必须在爪**之下**） */
  ellipsePx(g, 11, 41, 3, 2, SL_M);
  px(g, 10, 40, 3, 1, SL_L);

  /* 鬃：**暗底椭圆 + 沿上缘一整圈卷**。石狮的鬃就是一圈卷毛围着瞪眼的脸。
     ⚠️ 卷必须**绕着脸成圈**（20°~160°），不能只在头顶摆一排：只摆头顶那版
        放大后读成了"戴毛线帽的雪人"—— 两侧没有卷，鬃在轮廓上根本不存在。
     ⚠️ 8 颗 r2/r3 是"刚好互相咬住"的密度：相邻圆心距 3.5~4.1px、半径和 5px，
        于是卷与卷之间只留一道 1px 的暗缝 —— 读成一圈卷毛，而不是一串珠子。
        低于 6 颗就散成珠子，高于 10 颗就糊成一条毛边。
     ⚠️ 弧半径 13 + 脸半宽 8 ⇒ 鬃圈净厚 ~5px。**脸一定要比鬃小一圈**：
        v2 那版脸半宽 10、弧半径 12，脸把每个卷的内半边全盖掉，鬃只剩
        头顶一排骨刺。 */
  ellipsePx(g, CX, 16, 14, 13, SL_D);
  slCurlArc(g, CX, 15, 13, 20, 160, 8, 2, 0.86);
  /* 脸：**整只最亮的地方**（照片里狮脸是浅色的，鬃是深色的）。
     三层：SL_L 底 + SL_M 下巴（否则下脸和额头一样亮，嘴就陷进去看不见）
     + SL_HI 额头一点。⚠️ SL_HI 只给额头那 4×3，整张脸刷满 = 一块没五官的惨白斑。 */
  ellipsePx(g, CX, 18, 8, 9, SL_L);
  ellipsePx(g, CX, 23, 6, 4, SL_M);                  // 下巴（稍暗）
  ellipsePx(g, CX - 1, 14, 4, 3, SL_HI);             // 额头受光
  /* ⚠️ 没有耳朵：34px 宽的石狮放不下那对三角耳 —— 画上去只剩一条 1px 的斜刺
     （v2 就是），反而在轮廓上戳出两根天线。实拍照片里狮耳也基本埋在鬃里。
     头顶那两团略大的卷（20°/160°，r3）就是它全部的"耳"。 */

  /* ---- ② 描边（左上受光 / 右下背光，读→算→写各一拍） ----
     ⚠️ 左上用 SL_L 而不是 SL_HI：最亮的那档留给脸上，描边一提亮，
        连台基都会被镶上一圈白边（放大看像贴纸）。 */
  slEdge(g, W, H, -1, -1, SL_L);
  slEdge(g, W, H, 1, 1, SL_D);

  /* ---- ③ 刻画 ---- */
  /* 台基线脚：每级上棱提亮、级间压一道暗缝（照片里的台基是有线脚的） */
  px(g, 3, 55, 28, 1, SL_L);
  px(g, 6, 51, 22, 1, SL_DARK_D);
  px(g, 9, 48, 16, 1, SL_L);
  px(g, 3, 58, 28, 1, SL_BASE_D);
  px(g, 3, 61, 28, 1, SL_BASE_D);
  /* 眉：两道上挑的暗拱（**只画上半圈**）。
     ⚠️ 画整颗圆就成了"两眼上方各一颗黑痣"，而且圆心一挨近就连成一道帽檐。
        这里先落一颗 r2 暗珠、再用脸的中间调把下半圈抹掉 —— 剩下半道拱。
     ⚠️ 脸只有 15px 宽，两眉 r3 圆心距 10 ⇒ 中间只剩 3px，会连成一条横杠
        （整张脸读成"戴帽子的雪人"）。所以必须是 r2 + 圆心距 10。 */
  for (const bx of [12, 22]) {
    circlePx(g, bx, 13, 2, SL_D);
    px(g, bx - 2, 13, 5, 3, SL_L);
  }
  /* 眼：两颗凸出来的圆珠（石狮的标志），一深一亮。
     ⚠️ 3×3 是下限：2×2 在 34px 的狮子上就是两个点，读不出"瞪"。 */
  for (const ex of [13, 21]) {
    px(g, ex, 16, 3, 3, SL_S);
    px(g, ex, 16, 2, 2, SL_L);
    px(g, ex, 16, 1, 1, SL_HI);
  }
  /* 鼻：又宽又扁（比脸暗一档才看得见 —— 刷 SL_L 等于没画）。
     ⚠️ 鼻梁顶**只许提一档到 SL_L**：压一行 SL_HI 会在眉—眼—鼻之间连出一个
        亮"T"字，五官全糊在一起。 */
  poly(g, [[14, 20], [20, 20], [22, 22], [12, 22]], SL_M);
  px(g, 12, 20, 8, 1, SL_L);
  /* 嘴：张着，一道暗口 + 上下两排牙 */
  px(g, 14, 23, 6, 3, SL_S);
  for (let i = 0; i < 3; i++) {
    px(g, 14 + i * 2, 23, 1, 1, SL_M);               // 上排牙
    px(g, 14 + i * 2, 25, 1, 1, SL_M);               // 下排牙
  }
  /* 下颌那挂卷须：**一排半圆齿**，挂在下巴正下方的胸口上。
     ⚠️ 不能用 slCurl 排一排：那样每颗都是"暗环 + 亮芯 + 高光点"，4 颗并排
        放大后读成一串**珠子项链**（试过，比没有还糟）。
        这里改成和眉同一招 —— 落一排 r3 暗珠，再用躯干的中间调把**下半**抹掉，
        剩下 5 个向上出挑的暗齿 ⇒ 读成毛不是珠。
     ⚠️ **必须比鬃窄、比鬃短**：v2 那版上下各一排、上排 5 颗 r3 横跨 14px，
        放大后跟鬃连成一片，整只狮子变成一颗爆米花。
     ⚠️ 排在脸**之后**：它是从下巴挂下来的，压在胸口。 */
  for (let i = 0; i < 5; i++) {
    const bx = 9 + i * 4;
    circlePx(g, bx, 30, 3, SL_D);
    px(g, bx - 3, 30, 7, 2, SL_M);
  }
  /* 脚爪趾 */
  for (const fx of [10, 18]) for (let i = 0; i < 4; i++) px(g, fx + i, 47, 1, 2, SL_D);
  /* 绣球的镂空孔（透雕，一眼就能认出这是绣球而不是石头）。
     ⚠️ 球只有 r4，孔最多 4 颗：5 颗以上这颗球就散架了。 */
  for (const h of [[9, 42], [12, 42], [10, 46], [8, 44]]) px(g, h[0], h[1], 1, 1, SL_S);
  /* 尾巴尖那撮卷 */
  slCurl(g, 28, 33, 2, true);
  /* 躯干上的凿痕（照片里石狮身上散布着深色小斑，不是纯平涂） */
  for (const s of [[13, 37], [22, 38], [24, 31], [8, 39], [21, 44]]) px(g, s[0], s[1], 1, 1, SL_D);
  /* 收尾：撒一点风化亮斑（青石在户外会起白霜）。
     ⚠️ 只撒在**躯干**（y30..48），绝对不能撒到鬃和脸上 —— v2 那版铺满整只
        20 颗，鬃是暗底，亮斑在暗底上全亮起来，整只成了雪人。
     ⚠️ 数量按**成品面积**定：34×62 = 2108 像素，9 颗 = 0.43% ——
        和 28×46 那版（6 颗 / 1288 = 0.47%）同密度。密度是硬指标，不是手感。 */
  speckle(g, 5, 30, W - 10, 18, rgba(SL_L, 0.34), 9, rng);
  /* 台基在地上的接触影 */
  px(g, 3, H, 28, 1, "rgba(14,18,28,0.30)");
  px(g, 3, H + 1, 28, 1, "rgba(14,18,28,0.16)");
  return { canvas: c, ax: W / 2, ay: H };
}

/* --- 5.4.9 摆进世界 ---
   ⚠️ 碰撞盒一律按**成品尺寸**算（SM_DW/SL_DW），不是设计尺寸 —— 用 SM_W 会在
      已经减半的碑周围凭空围出一圈 100px 宽的"空气墙"。 */
function buildSouthStone() {
  addProp(Object.assign({}, makeSchoolStone(), { x: SM_X, y: SM_BY, tag: "smStone" }));
  /* 碑是一堵墙：碰撞盒给"足迹"（南沿 SM_BY 往北 11px），玩家绕得过去、穿不过去 */
  addSolid(SM_X, SM_BY, SM_DW - 12, 11);
  /* 石狮并排在西侧、同一条落地线（baseY 相等 ⇒ 谁也不压谁，水平上也不重叠） */
  addProp(Object.assign({}, makeStoneLion(), { x: SL_X, y: SL_BY, tag: "smLion" }));
  addSolid(SL_X, SL_BY, SL_DW - 6, 13);
}
