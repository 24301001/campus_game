@startuml 图2-1 总体总览
left to right direction
skinparam shadowing false
skinparam linetype ortho
skinparam nodesep 25
skinparam ranksep 70
skinparam defaultFontName "Microsoft YaHei"
skinparam defaultFontSize 13
skinparam actorStyle stickman
skinparam Usecase {
  BackgroundColor #F7F9FC
  BorderColor #2F5D8C
  FontSize 12
}

actor "玩家" as P

rectangle "像素校园 · AI 万事通" {
  usecase "登录 / 注册" as U1
  usecase "漫游地图" as U2
  usecase "与角色对话" as U3
  usecase "导航" as U4
  usecase "学业" as U5
  usecase "算法" as U6
  usecase "食堂" as U7
  usecase "安保" as U8
  usecase "猫宠陪伴" as U9
}

P -- U1
P -- U2
P -- U3
P -- U4
P -- U5
P -- U6
P -- U7
P -- U8
P -- U9

U4 ..> U3 : <<include>>
U2 ..> U1 : <<include>>

@enduml
